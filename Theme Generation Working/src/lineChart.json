{
  "visualStyles": {
    "lineChart": {
      "*": {
        "categoryAxis": [
          { "fontFamily": "Arial", "fontSize": 12 }
        ],
        "valueAxis": [
          { "show": false, "gridlineShow": false }
        ],
        "y2Axis": [
          { "show": false }
        ],
        "legend": [
          { "position": "TopRight", "fontSize": 14, "fontFamily": "Arial" }
        ],
        "lineStyles": [
          { "lineChartType": "linear", "strokeWidth": 7 }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Arial",
            "color": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 9, "Percent": 0 } } }
              }
            },
            "labelPosition": "Auto",
            "labelDensity": 0,
            "enableBackground": false,
            "backgroundTransparency": 0,
            "backgroundColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 2, "Percent": 0.6 } } }
              }
            }
          }
        ]
      }
    }
  }
}
