{
  "visualStyles": {
    "cardVisual": {
      "*": {
        "title": [
          { "show": false }
        ],
        "padding": [
          { "top": 0, "left": 0, "right": 0, "bottom": 0 }
        ],
        "value": [
          {
            "horizontalAlignment": "center",
            "fontSize": 24,
            "fontFamily": "Arial",
            "bold": true,
            "fontColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 9, "Percent": 0 } } }
              }
            },
            "labelDisplayUnits": 1
          }
        ],
        "label": [
          {
            "fontSize": 14,
            "fontFamily": "Arial",
            "textWrap": true,
            "fontColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 9, "Percent": 0 } } }
              }
            }
          }
        ],
        "cardCalloutArea": [
          { "paddingIndividual": false, "paddingTop": 0 }
        ],
        "layout": [
          { "calloutSize": 50 }
        ],
        "spacing": [
          { "verticalSpacing": 5 }
        ],
        "outline": [
          { "show": false }
        ],
        "divider": [
          { "show": false }
        ],
        "fillCustom": [
          { "show": false }
        ]
      }
    }
  }
}
