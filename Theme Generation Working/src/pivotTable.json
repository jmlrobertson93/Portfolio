{
  "visualStyles": {
    "pivotTable": {
      "*": {
        "padding": [
          { "top": 4, "left": 8, "right": 8, "bottom": 0 }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 0, "Percent": 0 } } }
              }
            },
            "backColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 4, "Percent": 0 } } }
              }
            },
            "bold": true,
            "fontFamily": "Arial",
            "alignment": "Center"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 0, "Percent": 0 } } }
              }
            },
            "backColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 4, "Percent": 0 } } }
              }
            },
            "bold": true,
            "fontFamily": "Arial",
            "alignment": "Left"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 9, "Percent": 0 } } }
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 0, "Percent": 0 } } }
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 9, "Percent": 0 } } }
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 0, "Percent": 0 } } }
              }
            },
            "fontSize": 14
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 9, "Percent": 0 } } }
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": { "expr": { "ThemeDataColor": { "ColorId": 0, "Percent": -0.1 } } }
              }
            },
            "gridHorizontalWeight": 2,
            "rowPadding": 3
          }
        ]
      }
    }
  }
}
