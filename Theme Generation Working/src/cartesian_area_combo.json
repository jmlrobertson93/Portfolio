{
  "_appliesTo": [
    "areaChart",
    "stackedAreaChart",
    "lineClusteredColumnComboChart",
    "lineStackedColumnComboChart"
  ],
  "styles": {
    "*": {
      "categoryAxis": [
        { "fontFamily": "Arial", "fontSize": 12, "gridlineShow": false }
      ],
      "valueAxis": [
        { "gridlineShow": false }
      ],
      "legend": [
        { "position": "TopRight", "fontSize": 14, "fontFamily": "Arial" }
      ],
      "lineStyles": [
        { "lineChartType": "linear", "strokeWidth": 7 }
      ]
    }
  }
}
