        "label": [
          {
            "fontSize": 14,
            "fontFamily": "Arial",
            "textWrap": true,
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": 9,
                      "Percent": 0
                    }
                  }
                }
              }
            }
          }
        ],
