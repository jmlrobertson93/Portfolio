table _Measures
	lineageTag: b21c4170-3b91-416a-81c2-116fa8348dd5

	measure 'Selected Measure' =
			SWITCH(
			    SELECTEDVALUE(FP_Measures[Measure]),
			    "Total Listening Time (hrs)", [Listening Time (hrs)],
			    "Total Listening Time (min)", [Listening Time (min)],
			    "Count of Streams", [Count of Streams],
			    "Unique Tracks", [Unique Tracks],
			    "Unique Artists", [Unique Artists],
			    "Unique Albums", [Unique Albums],
			    "Skip Rate %", [Skip Rate %],
			    "Shuffle Rate %", [Shuffle Rate %],
			    "Avg. Stream Duration (min)", [Avg. Stream Duration (min)],
			    "Offline Plays", [Offline Plays],
			    "Unique Shows", [Unique Shows]
			)
		formatString: #,0
		displayFolder: Dynamic Selection
		lineageTag: b21c4170-0001-0001-0001-000000000012

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Selected Measure Name' = SELECTEDVALUE(FP_Measures[Measure])
		displayFolder: Dynamic Selection
		lineageTag: b21c4170-0001-0001-0001-000000000013

	measure 'Selected Dimension Name' = SELECTEDVALUE(FP_Dimensions[Dimension Name])
		displayFolder: Dynamic Selection
		lineageTag: b21c4170-0001-0001-0001-000000000014

	measure 'Dynamic Visual Title' = [Selected Measure Name] & " by " & [Selected Dimension Name]
		displayFolder: Dynamic Selection
		lineageTag: b21c4170-0001-0001-0001-000000000015

	measure 'Listening Time (hrs)' = DIVIDE(SUM(fact_stream[ms_played]), 3600000)
		formatString: #,##0.0
		displayFolder: Listening
		lineageTag: b21c4170-0001-0001-0001-000000000001

	measure 'Listening Time (min)' = DIVIDE(SUM(fact_stream[ms_played]), 60000)
		formatString: #,##0.0
		displayFolder: Listening
		lineageTag: b21c4170-0001-0001-0001-000000000002

	measure 'Count of Streams' = COUNTROWS(fact_stream)
		formatString: #,0
		displayFolder: Listening
		lineageTag: b21c4170-0001-0001-0001-000000000003

	measure 'Unique Tracks' = DISTINCTCOUNT(fact_stream[track_key])
		formatString: #,0
		displayFolder: Listening\Discovery
		lineageTag: b21c4170-0001-0001-0001-000000000004

	measure 'Unique Artists' = DISTINCTCOUNT(fact_stream[artist_key])
		formatString: #,0
		displayFolder: Listening\Discovery
		lineageTag: b21c4170-0001-0001-0001-000000000005

	measure 'Unique Albums' = DISTINCTCOUNT(fact_stream[album_key])
		formatString: #,0
		displayFolder: Listening\Discovery
		lineageTag: b21c4170-0001-0001-0001-000000000006

	measure 'Skip Rate %' = DIVIDE(CALCULATE(COUNTROWS(fact_stream), fact_stream[skipped] = TRUE()), COUNTROWS(fact_stream))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Listening\Behaviour
		lineageTag: b21c4170-0001-0001-0001-000000000007

	measure 'Shuffle Rate %' = DIVIDE(CALCULATE(COUNTROWS(fact_stream), fact_stream[shuffle] = TRUE()), COUNTROWS(fact_stream))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Listening\Behaviour
		lineageTag: b21c4170-0001-0001-0001-000000000008

	measure 'Avg. Stream Duration (min)' = DIVIDE(AVERAGE(fact_stream[ms_played]), 60000)
		formatString: #,##0.00
		displayFolder: Listening
		lineageTag: b21c4170-0001-0001-0001-000000000009

	measure 'Offline Plays' = CALCULATE(COUNTROWS(fact_stream), fact_stream[offline] = TRUE())
		formatString: #,0
		displayFolder: Listening\Behaviour
		lineageTag: b21c4170-0001-0001-0001-000000000010

	measure 'Unique Shows' = DISTINCTCOUNT(fact_stream[show_key])
		formatString: #,0
		displayFolder: Listening\Discovery
		lineageTag: b21c4170-0001-0001-0001-000000000011

	measure 'Timseries Title' = [Selected Measure Name] & " by Date of Stream"
		displayFolder: Visual Titles
		lineageTag: 56a00569-624e-41dd-a5f7-900e924c9500

	measure 'Platform Title' = [Selected Measure Name] & " by Platform Category"
		displayFolder: Visual Titles
		lineageTag: 2842b614-1e7c-45e7-9593-e0f68301c19d

	measure 'Artist Title' = [Selected Measure Name] & " by Top 10 Artists"
		displayFolder: Visual Titles
		lineageTag: 75980caa-a8c9-4243-9ace-a3c7802ecdd8

	measure LinearRegression =
			-- Rank each artist by the selected measure (highest = rank 1)
			-- then fit OLS through those (rank, value) points.
			-- Returns the predicted value for the artist in current context.
			VAR ArtistData =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_artist[Artist Name]),
			        "@Y", [Selected Measure]
			    )
			VAR ArtistRanked =
			    ADDCOLUMNS(
			        ArtistData,
			        "@X", RANKX(ArtistData, [@Y],, DESC, DENSE)
			    )
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X])
			VAR Slope =
			    MAXX(Line, [Slope1])
			VAR Intercept =
			    MAXX(Line, [Intercept])
			VAR CurrentArtist =
			    SELECTEDVALUE(dim_artist[Artist Name])
			VAR CurrentX =
			    MAXX(FILTER(ArtistRanked, [Artist Name] = CurrentArtist), [@X])
			RETURN
			    IF(
			        NOT ISBLANK(CurrentArtist),
			        Slope * CurrentX + Intercept
			    )
		displayFolder: Regression
		lineageTag: ac000001-0001-0001-0001-000000000001

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression Slope' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			RETURN
			    MAXX(Line, [Slope1])
		formatString: #,##0.000
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000002

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression Intercept' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			RETURN
			    MAXX(Line, [Intercept])
		formatString: #,##0.000
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000003

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression R²' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			RETURN
			    MAXX(Line, [r2])
		formatString: 0.000
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000004

	measure 'Regression Adj. R²' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			VAR n =
			    COUNTROWS(ArtistData)
			VAR R2 =
			    MAXX(Line, [r2])
			RETURN
			    IF(n > 2, 1 - (1 - R2) * (n - 1) / (n - 2))
		formatString: 0.000
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000005

	measure 'Regression F-Stat' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			RETURN
			    MAXX(Line, [F])
		formatString: #,##0.00
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000006

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression SE (Slope)' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			RETURN
			    MAXX(Line, [SE1])
		formatString: #,##0.000
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000007

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression t-Stat' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			VAR Slope =
			    MAXX(Line, [Slope1])
			VAR SE =
			    MAXX(Line, [SE1])
			RETURN
			    DIVIDE(Slope, SE)
		formatString: #,##0.00
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000008

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression n' = COUNTROWS(ALLSELECTED(dim_artist[Artist Name]))
		formatString: #,0
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000009

	measure 'Regression Significance' =
			VAR ArtistData =
			    ADDCOLUMNS(ALLSELECTED(dim_artist[Artist Name]), "@Y", [Selected Measure])
			VAR ArtistRanked =
			    ADDCOLUMNS(ArtistData, "@X", RANKX(ArtistData, [@Y],, DESC, DENSE))
			VAR Line =
			    LINESTX(ArtistRanked, [@Y], [@X], TRUE, TRUE)
			VAR Slope =
			    MAXX(Line, [Slope1])
			VAR SE =
			    MAXX(Line, [SE1])
			VAR AbsT =
			    ABS(DIVIDE(Slope, SE))
			RETURN
			    SWITCH(
			        TRUE(),
			        AbsT > 3.29, "p < 0.001 ***",
			        AbsT > 2.58, "p < 0.01 **",
			        AbsT > 1.96, "p < 0.05 *",
			        "Not significant"
			    )
		displayFolder: Regression\Statistics
		lineageTag: ac000001-0001-0001-0001-000000000010

	measure 'Metadata Txt' = ```
			"Data Refreshed : 01/01/2026 || Model v2.3.5 || Report v1.1.3" 
